# Copy this file to .env. Never commit the real .env file.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Local development defaults
APP_DEBUG=false
HOST=127.0.0.1
PORT=5000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL=604800
TRUST_PROXY_HEADERS=false
DEV_FRONTEND_ORIGIN=http://localhost:5173

# Optional: use a different SQLite database location.
# CHAT_DB_PATH=C:\absolute\path\to\chat.db
