# Copy this file to templates/.env. Never commit the real .env file.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Used only by the local Node Pi agent service. Flask never sends this key to a browser.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
AGENT_BASE_URL=http://127.0.0.1:8787

# Local development defaults
APP_DEBUG=false
HOST=127.0.0.1
PORT=5000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL=604800
TRUST_PROXY_HEADERS=false
DEV_FRONTEND_ORIGIN=http://localhost:5173
MAX_CHECKPOINT_CHARS=80000

# Optional: use a different SQLite database location.
# CHAT_DB_PATH=C:\absolute\path\to\chat.db
