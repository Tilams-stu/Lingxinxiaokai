# 敏感配置文件 - 不要提交到版本控制
# Sensitive configuration files - Do not commit to version control
.env
config.js

# API密钥和凭证
# API keys and credentials
*.key
*.pem
*.p12
*.keystore

# 日志文件
# Log files
*.log
logs/

# 临时文件
# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# 编辑器配置
# Editor configuration
.vscode/
.idea/
*.swp
*.swo

# 依赖目录
# Dependencies
node_modules/

# 构建输出（若希望 dist 不入库可取消注释下一行；当前将 templates/dist 纳入版本便于克隆即用）
# dist/
build/

# 缓存
# Cache
.cache/
*.cache